digraph callgraph {
  rankdir=TB;
  ranksep=0.6;
  nodesep=0.25;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.05,0.03", penwidth=1.3];
  edge [color="#333333", fontname="Helvetica", fontcolor="#333333", fontsize=9, arrowsize=0.7, penwidth=1.1];

  // entry layer
  entry [label="CS_Sts_Gyro_Modify_Single_pipeline", style="rounded,bold,filled", color="#D97777", fillcolor="#FFF1F1", fontcolor="#7E3434", penwidth=1.7];

  // stage layer
  StsCompensate [color="#9B7BB7", fillcolor="#F5EFFA", fontcolor="#5F4776"];
  StsModify     [color="#9B7BB7", fillcolor="#F5EFFA", fontcolor="#5F4776"];
  StsFilter     [color="#9B7BB7", fillcolor="#F5EFFA", fontcolor="#5F4776"];

  // helper / leaf layer
  mat_mul         [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  vec_add         [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  vec_sub         [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  vec_scale       [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  vec_cross3      [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  q_to_C          [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  q_to_Ksi        [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  q_normalize     [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  limit_abs       [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];
  triple_fabs_max [color="#8EB4DC", fillcolor="#F4FAFF", fontcolor="#4D6F92"];

  {rank=same; StsCompensate; StsModify; StsFilter}
  {rank=same; mat_mul; vec_add; vec_sub; vec_scale; vec_cross3;
              q_to_C; q_to_Ksi; q_normalize; limit_abs; triple_fabs_max}

  entry -> StsCompensate [label="×3"];
  entry -> StsModify;
  entry -> StsFilter;

  StsCompensate -> mat_mul;

  StsModify -> mat_mul [label="×8"];
  StsModify -> vec_add [label="×6"];
  StsModify -> vec_cross3 [label="×3"];
  StsModify -> vec_sub [label="×2"];
  StsModify -> vec_scale;
  StsModify -> q_to_C;
  StsModify -> triple_fabs_max;

  StsFilter -> mat_mul [label="×2"];
  StsFilter -> q_to_Ksi;
  StsFilter -> q_normalize;
  StsFilter -> limit_abs;
}
