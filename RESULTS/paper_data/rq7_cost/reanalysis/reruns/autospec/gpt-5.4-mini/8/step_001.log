int is_prime_(int n, int m);

int mult(int n, int m) {

    if (m < 0) {
      return mult(n, -m);
    }
    if (m == 0) {
      return 0;
    }
    if (m == 1) {
      return 1;
    }
    return n + mult(n, m - 1);
}

int multiple_of(int n, int m) {

    if (m < 0) {
