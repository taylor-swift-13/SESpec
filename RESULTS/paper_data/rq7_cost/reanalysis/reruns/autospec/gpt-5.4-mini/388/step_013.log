int findNthDigit(int num, int c, int r) {

		int result = 0;
		/*@
		>>> INFILL <<<
		loop invariant result >= 0 ==> num >= 0;
		loop invariant result == num / c;
		loop invariant result == num / c || result == 0;
		loop invariant result == num / c || r >= 0;
		loop invariant result == num / c || r > 0;
		loop invariant result == 0 || result == num / c;
		loop invariant result <= num / c;
		loop invariant result <= num / c || result == 0;
		loop invariant r <= r + 1;
		loop invariant r <= c;
		loop invariant num >= 0 ==> result >= 0;
		loop invariant num == 0 || result >= 0;
		loop invariant num == (num / c) * c + num % c;
		loop invariant num == (num / c) * c + (num % c);
		loop invariant num < c || result == num / c;
		loop invariant num % c == num - (num / c) * c;
		loop invariant num % c == 0 || result == 0;
		loop invariant num % c < c;
		loop invariant c != 0;
		loop invariant 0 <= result;
		loop invariant 0 <= r;
		loop invariant 0 <= r + result;
		loop invariant 0 <= num;
		loop invariant 0 <= num % c;
		loop invariant 0 < c;
		loop assigns result;
		loop assigns r;
		loop assigns num;
		*/
		while (r > 0) {
			r -= 1;
			num *= 10;
			result = num / c;
			num %= c;
		}
		return result;
}

